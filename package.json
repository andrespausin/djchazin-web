    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "d3-geo": "^3.1.1",
    "potrace": "^2.1.8",
    "sharp": "^0.35.5",
